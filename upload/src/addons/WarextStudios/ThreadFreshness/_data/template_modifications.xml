<?xml version='1.0' encoding='utf-8'?>
<template_modifications>
  <modification type="admin" template="forum_edit" modification_key="wrxt_thread_freshness_forum_edit" description="Forum bazlı konu güncellik ayarlarını ekler" execution_order="10" enabled="1" action="str_replace">
    <find>&lt;xf:option name="allow_posting"</find>
    <replace>&lt;xf:option name="wrxt_freshness_enabled" selected="$forum.wrxt_freshness_enabled"
    label="{{ phrase('wrxt_freshness_enable_forum') }}"
    hint="{{ phrase('wrxt_freshness_enable_forum_hint') }}"&gt;
    &lt;div class="formRow-explain"&gt;{{ phrase('wrxt_freshness_days_explain') }}&lt;/div&gt;
    &lt;xf:numberbox name="wrxt_freshness_days" value="{$forum.wrxt_freshness_days}" min="1" max="3650" step="1" /&gt;
    &lt;div class="formRow-explain"&gt;{{ phrase('wrxt_freshness_age_method') }}&lt;/div&gt;
    &lt;xf:select name="wrxt_freshness_age_mode" value="{$forum.wrxt_freshness_age_mode}"&gt;
        &lt;xf:option value="meaningful"&gt;{{ phrase('wrxt_freshness_age_meaningful_explain') }}&lt;/xf:option&gt;
        &lt;xf:option value="last_post"&gt;{{ phrase('wrxt_freshness_age_last_post_explain') }}&lt;/xf:option&gt;
    &lt;/xf:select&gt;
    &lt;div class="formRow-explain"&gt;{{ phrase('wrxt_freshness_versions_explain') }}&lt;/div&gt;
    &lt;xf:textarea name="wrxt_freshness_versions" value="{$forum.wrxt_freshness_versions}" autosize="true" maxlength="5000" /&gt;
&lt;/xf:option&gt;

$0</replace>
  </modification>
  <modification type="public" template="forum_view" modification_key="wrxt_thread_freshness_forum_filter" description="Forum konu listesine güncellik filtre menüsü ekler" execution_order="20" enabled="1" action="str_replace">
    <find>&lt;xf:ad position="forum_view_above_thread_list" arg-forum="{$forum}" /&gt;</find>
    <replace>&lt;xf:if is="$forum.wrxt_freshness_enabled"&gt;
    &lt;div class="block-outer"&gt;
        &lt;div class="block-outer-opposite"&gt;
            &lt;a class="button button--link menuTrigger" data-xf-click="menu" role="button" tabindex="0" aria-expanded="false" aria-haspopup="true"&gt;{{ phrase('wrxt_freshness_filter') }}&lt;/a&gt;
            &lt;div class="menu" data-menu="menu" aria-hidden="true"&gt;
                &lt;div class="menu-content"&gt;
                    &lt;a class="menu-linkRow" href="{{ link('forums', $forum, array_merge($filters, {'freshness_status': null})) }}"&gt;{{ phrase('wrxt_freshness_all') }}&lt;/a&gt;
                    &lt;a class="menu-linkRow" href="{{ link('forums', $forum, array_merge($filters, {'freshness_status': 'current'})) }}"&gt;{{ phrase('wrxt_freshness_status_current') }}&lt;/a&gt;
                    &lt;a class="menu-linkRow" href="{{ link('forums', $forum, array_merge($filters, {'freshness_status': 'likely_current'})) }}"&gt;{{ phrase('wrxt_freshness_status_likely_current') }}&lt;/a&gt;
                    &lt;a class="menu-linkRow" href="{{ link('forums', $forum, array_merge($filters, {'freshness_status': 'mixed'})) }}"&gt;{{ phrase('wrxt_freshness_status_mixed') }}&lt;/a&gt;
                    &lt;a class="menu-linkRow" href="{{ link('forums', $forum, array_merge($filters, {'freshness_status': 'questionable'})) }}"&gt;{{ phrase('wrxt_freshness_status_questionable') }}&lt;/a&gt;
                    &lt;a class="menu-linkRow" href="{{ link('forums', $forum, array_merge($filters, {'freshness_status': 'not_working'})) }}"&gt;{{ phrase('wrxt_freshness_status_not_working') }}&lt;/a&gt;
                    &lt;a class="menu-linkRow" href="{{ link('forums', $forum, array_merge($filters, {'freshness_status': 'revalidating'})) }}"&gt;{{ phrase('wrxt_freshness_status_revalidating') }}&lt;/a&gt;
                    &lt;a class="menu-linkRow" href="{{ link('forums', $forum, array_merge($filters, {'freshness_status': 'unverified'})) }}"&gt;{{ phrase('wrxt_freshness_status_unverified') }}&lt;/a&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/xf:if&gt;
$0</replace>
  </modification>
  <modification type="public" template="thread_list_macros" modification_key="wrxt_thread_freshness_thread_list" description="Konu listesine güncellik durum rozetini ekler" execution_order="20" enabled="1" action="str_replace">
    <find>&lt;xf:if is="$thread.prefix_id"&gt;</find>
    <replace>&lt;xf:if is="$thread.hasWrxtFreshnessListData() AND $thread.isWrxtFreshnessEligible()"&gt;
    &lt;xf:set var="$wrxtListStatus" value="{$thread.getWrxtFreshnessDisplayStatus()}" /&gt;
    &lt;xf:if is="$wrxtListStatus == 'current'"&gt;
        &lt;span class="label label--green"&gt;{{ phrase('wrxt_freshness_status_current') }}&lt;/span&gt;
    &lt;xf:elseif is="$wrxtListStatus == 'likely_current'" /&gt;
        &lt;span class="label label--olive"&gt;{{ phrase('wrxt_freshness_status_likely_current') }}&lt;/span&gt;
    &lt;xf:elseif is="$wrxtListStatus == 'mixed'" /&gt;
        &lt;span class="label label--yellow"&gt;{{ phrase('wrxt_freshness_status_mixed') }}&lt;/span&gt;
    &lt;xf:elseif is="$wrxtListStatus == 'questionable'" /&gt;
        &lt;span class="label label--orange"&gt;{{ phrase('wrxt_freshness_status_questionable') }}&lt;/span&gt;
    &lt;xf:elseif is="$wrxtListStatus == 'not_working'" /&gt;
        &lt;span class="label label--red"&gt;{{ phrase('wrxt_freshness_status_not_working') }}&lt;/span&gt;
    &lt;xf:elseif is="$wrxtListStatus == 'revalidating'" /&gt;
        &lt;span class="label label--blue"&gt;{{ phrase('wrxt_freshness_status_revalidating') }}&lt;/span&gt;
    &lt;xf:else /&gt;
        &lt;span class="label"&gt;{{ phrase('wrxt_freshness_status_unverified') }}&lt;/span&gt;
    &lt;/xf:if&gt;
&lt;/xf:if&gt;
$0</replace>
  </modification>
  <modification type="public" template="thread_view" modification_key="wrxt_thread_freshness_thread_view" description="Konu güncellik doğrulama panelini konu görünümüne ekler" execution_order="10" enabled="1" action="preg_replace">
    <find>#&lt;xf:ad position="thread_view_below_messages" arg-thread="\{\$thread\}" /&gt;#</find>
    <replace>&lt;xf:if is="$thread.isWrxtFreshnessEnabled()"&gt;
    &lt;xf:css src="wrxt_thread_freshness.less" /&gt;
    &lt;xf:js src="warext/thread_freshness.js" /&gt;
    &lt;xf:set var="$wrxtState" value="{$thread.getWrxtFreshnessState()}" /&gt;
    &lt;xf:set var="$wrxtStateCurrent" value="{$thread.isWrxtFreshnessStateCurrent()}" /&gt;
    &lt;xf:set var="$wrxtDisplayStatus" value="{$thread.getWrxtFreshnessDisplayStatus()}" /&gt;
    &lt;xf:set var="$wrxtVisitorVote" value="{$thread.getWrxtFreshnessVisitorVote()}" /&gt;
    &lt;xf:set var="$wrxtVoteEntity" value="{$thread.getWrxtFreshnessVisitorVoteEntity()}" /&gt;
    &lt;xf:set var="$wrxtVersions" value="{$thread.getWrxtFreshnessConfiguredVersions()}" /&gt;
    &lt;xf:set var="$wrxtVersionSummary" value="{$thread.getWrxtFreshnessVersionSummary()}" /&gt;
    &lt;xf:set var="$wrxtReasonSummary" value="{$thread.getWrxtFreshnessFailureReasonSummary()}" /&gt;
    &lt;xf:set var="$wrxtReplacement" value="{$thread.getWrxtFreshnessReplacementThread()}" /&gt;
    &lt;xf:set var="$wrxtSuggestions" value="{$thread.getWrxtFreshnessAlternativeSuggestions()}" /&gt;

    &lt;div class="wrxtFreshness" id="wrxt-thread-freshness" style="width:100%;max-width:360px;margin:8px 0 12px auto;"&gt;
        &lt;div class="block-container"&gt;
  &lt;xf:if is="$thread.isWrxtFreshnessEligible()"&gt;
      &lt;div class="wrxtFreshness-main"&gt;
          &lt;div class="wrxtFreshness-top"&gt;
              &lt;div class="wrxtFreshness-heading"&gt;
                  &lt;strong class="wrxtFreshness-title"&gt;{{ phrase('wrxt_freshness_solution_freshness') }}&lt;/strong&gt;
                  &lt;xf:if is="$wrxtStateCurrent AND $wrxtState"&gt;
                      &lt;xf:if is="$wrxtDisplayStatus == 'current'"&gt;&lt;span class="label label--green"&gt;{{ phrase('wrxt_freshness_status_current') }}&lt;/span&gt;
                      &lt;xf:elseif is="$wrxtDisplayStatus == 'likely_current'" /&gt;&lt;span class="label label--olive"&gt;{{ phrase('wrxt_freshness_status_likely_current') }}&lt;/span&gt;
                      &lt;xf:elseif is="$wrxtDisplayStatus == 'mixed'" /&gt;&lt;span class="label label--yellow"&gt;{{ phrase('wrxt_freshness_status_mixed') }}&lt;/span&gt;
                      &lt;xf:elseif is="$wrxtDisplayStatus == 'questionable'" /&gt;&lt;span class="label label--orange"&gt;{{ phrase('wrxt_freshness_status_questionable_short') }}&lt;/span&gt;
                      &lt;xf:elseif is="$wrxtDisplayStatus == 'not_working'" /&gt;&lt;span class="label label--red"&gt;{{ phrase('wrxt_freshness_status_not_working_short') }}&lt;/span&gt;
                      &lt;xf:elseif is="$wrxtDisplayStatus == 'revalidating'" /&gt;&lt;span class="label label--blue"&gt;{{ phrase('wrxt_freshness_status_revalidating') }}&lt;/span&gt;
                      &lt;xf:else /&gt;&lt;span class="label"&gt;{{ phrase('wrxt_freshness_status_unverified') }}&lt;/span&gt;&lt;/xf:if&gt;
                  &lt;xf:else /&gt;
                      &lt;span class="label"&gt;{{ phrase('wrxt_freshness_status_unverified') }}&lt;/span&gt;
                  &lt;/xf:if&gt;
              &lt;/div&gt;
              &lt;div class="wrxtFreshness-icons"&gt;
                  &lt;details class="wrxtFreshness-pop wrxtFreshness-help"&gt;
                      &lt;summary class="button button--link wrxtFreshness-toolButton" title="{{ phrase('wrxt_freshness_help_title') }}" aria-label="{{ phrase('wrxt_freshness_help_title') }}"&gt;&lt;span aria-hidden="true"&gt;ⓘ&lt;/span&gt; {{ phrase('wrxt_freshness_info') }}&lt;/summary&gt;
                      &lt;div class="wrxtFreshness-popBody"&gt;
                          &lt;strong&gt;{{ phrase('wrxt_freshness_help_question') }}&lt;/strong&gt;
                          &lt;p&gt;{{ phrase('wrxt_freshness_help_threshold') }}&lt;/p&gt;
                          &lt;p&gt;{{ phrase('wrxt_freshness_help_owner_moderator') }}&lt;/p&gt;
                      &lt;/div&gt;
                  &lt;/details&gt;
                  &lt;xf:if is="$thread.canWrxtFreshnessOwnerClaim() OR $thread.canWrxtFreshnessModerate() OR $thread.canWrxtFreshnessManageReplacement()"&gt;
                      &lt;details class="wrxtFreshness-pop wrxtFreshness-actions"&gt;
                          &lt;summary class="button button--link wrxtFreshness-toolButton" title="{{ phrase('wrxt_freshness_actions') }}" aria-label="{{ phrase('wrxt_freshness_actions') }}"&gt;&lt;span aria-hidden="true"&gt;⚙&lt;/span&gt; {{ phrase('wrxt_freshness_actions') }}&lt;/summary&gt;
                          &lt;div class="wrxtFreshness-popBody wrxtFreshness-popBody--actions"&gt;
                              &lt;xf:if is="$thread.canWrxtFreshnessOwnerClaim()"&gt;
                                  &lt;xf:form action="{{ link('threads/freshness-owner-claim', $thread) }}"&gt;
                                      &lt;xf:hiddenval name="claimed"&gt;{{ $thread.hasWrxtFreshnessOwnerClaim() ? 0 : 1 }}&lt;/xf:hiddenval&gt;
                                      &lt;xf:button type="submit" class="button--link"&gt;{{ $thread.hasWrxtFreshnessOwnerClaim() ? phrase('wrxt_freshness_remove_verification') : phrase('wrxt_freshness_owner_still_valid') }}&lt;/xf:button&gt;
                                  &lt;/xf:form&gt;
                              &lt;/xf:if&gt;
                              &lt;xf:if is="$thread.canWrxtFreshnessModerate()"&gt;
                                  &lt;xf:set var="$wrxtModState" value="{$thread.getWrxtFreshnessState()}" /&gt;
                                  &lt;xf:form action="{{ link('threads/freshness-moderate', $thread) }}" ajax="true" class="wrxtFreshness-actionForm"&gt;
                                      &lt;xf:select name="moderator_status" value="{{ $wrxtModState ? $wrxtModState.moderator_status : '' }}"&gt;
                                          &lt;xf:option value=""&gt;{{ phrase('wrxt_freshness_use_community_result') }}&lt;/xf:option&gt;
                                          &lt;xf:option value="current"&gt;{{ phrase('wrxt_freshness_moderator_current') }}&lt;/xf:option&gt;
                                          &lt;xf:option value="review"&gt;{{ phrase('wrxt_freshness_review_required') }}&lt;/xf:option&gt;
                                          &lt;xf:option value="not_working"&gt;{{ phrase('wrxt_freshness_moderator_not_working') }}&lt;/xf:option&gt;
                                      &lt;/xf:select&gt;
                                      &lt;xf:button type="submit"&gt;{{ phrase('wrxt_freshness_save') }}&lt;/xf:button&gt;
                                  &lt;/xf:form&gt;
                              &lt;/xf:if&gt;
                              &lt;xf:if is="$thread.canWrxtFreshnessManageReplacement()"&gt;
                                  &lt;xf:form action="{{ link('threads/freshness-replacement', $thread) }}" ajax="true" class="wrxtFreshness-actionForm"&gt;
                                      &lt;xf:numberbox name="replacement_thread_id" value="{{ $thread.getWrxtFreshnessState() ? $thread.getWrxtFreshnessState().replacement_thread_id : 0 }}" min="0" /&gt;
                                      &lt;xf:button type="submit"&gt;{{ phrase('wrxt_freshness_current_thread') }}&lt;/xf:button&gt;
                                  &lt;/xf:form&gt;
                              &lt;/xf:if&gt;
                          &lt;/div&gt;
                      &lt;/details&gt;
                  &lt;/xf:if&gt;
              &lt;/div&gt;
          &lt;/div&gt;

          &lt;div class="wrxtFreshness-meta"&gt;
              &lt;xf:if is="$wrxtStateCurrent AND $wrxtState"&gt;
                  &lt;span&gt;&lt;b&gt;{$wrxtState.positive_count}&lt;/b&gt; ✓&lt;/span&gt;
                  &lt;span&gt;&lt;b&gt;{$wrxtState.negative_count}&lt;/b&gt; ✕&lt;/span&gt;
                  &lt;span&gt;{$wrxtState.vote_count} oy&lt;/span&gt;
              &lt;xf:else /&gt;
                  &lt;span&gt;{{ phrase('wrxt_freshness_no_votes') }}&lt;/span&gt;
              &lt;/xf:if&gt;
              &lt;xf:if is="$thread.hasWrxtFreshnessOwnerClaim()"&gt;&lt;span class="wrxtFreshness-ownerBadge"&gt;{{ phrase('wrxt_freshness_owner_verified') }}&lt;/span&gt;&lt;/xf:if&gt;
          &lt;/div&gt;

          &lt;xf:if is="$wrxtReplacement"&gt;
              &lt;div class="wrxtFreshness-replacement"&gt;&lt;a href="{{ link('threads', $wrxtReplacement) }}"&gt;{{ phrase('wrxt_freshness_open_newer_solution') }}&lt;/a&gt;&lt;/div&gt;
          &lt;/xf:if&gt;

          &lt;xf:if is="$thread.canWrxtFreshnessVote()"&gt;
              &lt;xf:form action="{{ link('threads/freshness-vote', $thread) }}" ajax="true" class="wrxtFreshness-voteForm"&gt;
                  &lt;div class="wrxtFreshness-choiceGroup" role="radiogroup" aria-label="{{ phrase('wrxt_freshness_solution_result') }}"&gt;
                      &lt;label class="wrxtFreshness-choice wrxtFreshness-choice--yes"&gt;
                          &lt;input class="wrxtFreshness-choiceInput" type="radio" name="vote" value="1" required="required" checked="{{ $wrxtVisitorVote == 1 ? 'checked' : '' }}" /&gt;
                          &lt;span class="button button--link wrxtFreshness-choiceSurface"&gt;
                              &lt;span class="wrxtFreshness-choiceMark" aria-hidden="true"&gt;✓&lt;/span&gt;
                              &lt;span class="wrxtFreshness-choiceText"&gt;&lt;b&gt;{{ phrase('wrxt_freshness_worked') }}&lt;/b&gt;&lt;/span&gt;
                          &lt;/span&gt;
                      &lt;/label&gt;
                      &lt;label class="wrxtFreshness-choice wrxtFreshness-choice--no"&gt;
                          &lt;input class="wrxtFreshness-choiceInput" type="radio" name="vote" value="-1" required="required" checked="{{ $wrxtVisitorVote == -1 ? 'checked' : '' }}" /&gt;
                          &lt;span class="button button--link wrxtFreshness-choiceSurface"&gt;
                              &lt;span class="wrxtFreshness-choiceMark" aria-hidden="true"&gt;✕&lt;/span&gt;
                              &lt;span class="wrxtFreshness-choiceText"&gt;&lt;b&gt;{{ phrase('wrxt_freshness_did_not_work') }}&lt;/b&gt;&lt;/span&gt;
                          &lt;/span&gt;
                      &lt;/label&gt;
                  &lt;/div&gt;
                  &lt;details class="wrxtFreshness-more wrxtFreshness-voteDetails"&gt;
                      &lt;summary class="button button--link wrxtFreshness-moreButton"&gt;{{ phrase('wrxt_freshness_details') }}&lt;/summary&gt;
                      &lt;div class="wrxtFreshness-fields"&gt;
                          &lt;div class="wrxtFreshness-fieldsHead"&gt;&lt;strong&gt;{{ phrase('wrxt_freshness_vote_details') }}&lt;/strong&gt;&lt;button type="button" class="button button--link wrxtFreshness-fieldsClose" data-wrxt-detail-close="1" aria-label="{{ phrase('wrxt_freshness_close') }}"&gt;✕&lt;/button&gt;&lt;/div&gt;
                          &lt;label&gt;&lt;span&gt;{{ phrase('wrxt_freshness_version') }}&lt;/span&gt;
                              &lt;xf:if is="$wrxtVersions"&gt;
                                  &lt;xf:select name="version" value="{{ $wrxtVoteEntity ? $wrxtVoteEntity.version : '' }}"&gt;
                                      &lt;xf:option value=""&gt;{{ phrase('wrxt_freshness_select') }}&lt;/xf:option&gt;
                                      &lt;xf:foreach loop="$wrxtVersions" value="$wrxtVersion"&gt;&lt;xf:option value="{$wrxtVersion}"&gt;{$wrxtVersion}&lt;/xf:option&gt;&lt;/xf:foreach&gt;
                                  &lt;/xf:select&gt;
                              &lt;xf:else /&gt;
                                  &lt;xf:textbox name="version" value="{{ $wrxtVoteEntity ? $wrxtVoteEntity.version : '' }}" maxlength="100" /&gt;
                              &lt;/xf:if&gt;
                          &lt;/label&gt;
                          &lt;label&gt;&lt;span&gt;{{ phrase('wrxt_freshness_reason') }}&lt;/span&gt;
                              &lt;xf:select name="reason" value="{{ $wrxtVoteEntity ? $wrxtVoteEntity.reason : '' }}"&gt;
                                  &lt;xf:option value=""&gt;{{ phrase('wrxt_freshness_prefer_not_select') }}&lt;/xf:option&gt;
                                  &lt;xf:option value="outdated_version"&gt;{{ phrase('wrxt_freshness_reason_outdated_version') }}&lt;/xf:option&gt;
                                  &lt;xf:option value="dead_links"&gt;{{ phrase('wrxt_freshness_reason_dead_links') }}&lt;/xf:option&gt;
                                  &lt;xf:option value="method_invalid"&gt;{{ phrase('wrxt_freshness_reason_method_invalid') }}&lt;/xf:option&gt;
                                  &lt;xf:option value="incomplete"&gt;{{ phrase('wrxt_freshness_reason_incomplete') }}&lt;/xf:option&gt;
                                  &lt;xf:option value="did_not_work"&gt;{{ phrase('wrxt_freshness_failed_on_system') }}&lt;/xf:option&gt;
                                  &lt;xf:option value="other"&gt;{{ phrase('wrxt_freshness_other') }}&lt;/xf:option&gt;
                              &lt;/xf:select&gt;
                          &lt;/label&gt;
                          &lt;label&gt;&lt;span&gt;{{ phrase('wrxt_freshness_description') }}&lt;/span&gt;&lt;xf:textbox name="message" value="{{ $wrxtVoteEntity ? $wrxtVoteEntity.message : '' }}" maxlength="500" /&gt;&lt;/label&gt;
                          &lt;label&gt;&lt;span&gt;{{ phrase('wrxt_freshness_current_thread_id') }}&lt;/span&gt;&lt;xf:numberbox name="alternative_thread_id" value="{{ $wrxtVoteEntity ? $wrxtVoteEntity.alternative_thread_id : 0 }}" min="0" /&gt;&lt;/label&gt;
                      &lt;/div&gt;
                  &lt;/details&gt;
                  &lt;div class="wrxtFreshness-saveBar"&gt;
                      &lt;xf:button type="submit" class="button--primary wrxtFreshness-saveButton"&gt;{{ $wrxtVisitorVote ? phrase('wrxt_freshness_update') : phrase('wrxt_freshness_save') }}&lt;/xf:button&gt;
                  &lt;/div&gt;
              &lt;/xf:form&gt;
          &lt;/xf:if&gt;

          &lt;xf:if is="$wrxtReasonSummary OR $wrxtVersionSummary"&gt;
              &lt;details class="wrxtFreshness-more"&gt;
                  &lt;summary&gt;{{ phrase('wrxt_freshness_result_details') }}&lt;/summary&gt;
                  &lt;div class="wrxtFreshness-resultsBody"&gt;
                      &lt;xf:if is="$wrxtReasonSummary"&gt;
                          &lt;strong&gt;{{ phrase('wrxt_freshness_failure_reasons') }}&lt;/strong&gt;
                          &lt;xf:foreach loop="$wrxtReasonSummary" key="$wrxtReason" value="$wrxtReasonTotal"&gt;&lt;div class="pairs pairs--justified"&gt;&lt;span&gt;{$wrxtReason}&lt;/span&gt;&lt;b&gt;{$wrxtReasonTotal|number}&lt;/b&gt;&lt;/div&gt;&lt;/xf:foreach&gt;
                      &lt;/xf:if&gt;
                      &lt;xf:if is="$wrxtVersionSummary"&gt;
                          &lt;strong&gt;{{ phrase('wrxt_freshness_version_results') }}&lt;/strong&gt;
                          &lt;xf:foreach loop="$wrxtVersionSummary" value="$wrxtVersionRow"&gt;&lt;div class="pairs pairs--justified"&gt;&lt;span&gt;{$wrxtVersionRow.version}&lt;/span&gt;&lt;span&gt;{$wrxtVersionRow.positive_count} / {$wrxtVersionRow.negative_count}&lt;/span&gt;&lt;/div&gt;&lt;/xf:foreach&gt;
                      &lt;/xf:if&gt;
                  &lt;/div&gt;
              &lt;/details&gt;
          &lt;/xf:if&gt;
      &lt;/div&gt;
  &lt;xf:else /&gt;
      &lt;div class="wrxtFreshness-main wrxtFreshness-main--waiting"&gt;
          &lt;div class="wrxtFreshness-top"&gt;
              &lt;div class="wrxtFreshness-heading"&gt;&lt;strong class="wrxtFreshness-title"&gt;{{ phrase('wrxt_freshness_voting') }}&lt;/strong&gt;&lt;span class="label"&gt;{$thread.getWrxtFreshnessDaysUntilEligible()} gün&lt;/span&gt;&lt;/div&gt;
              &lt;details class="wrxtFreshness-pop wrxtFreshness-help"&gt;
                  &lt;summary class="button button--link wrxtFreshness-toolButton" title="{{ phrase('wrxt_freshness_info') }}"&gt;&lt;span aria-hidden="true"&gt;ⓘ&lt;/span&gt; {{ phrase('wrxt_freshness_info') }}&lt;/summary&gt;
                  &lt;div class="wrxtFreshness-popBody"&gt;&lt;strong&gt;{{ phrase('wrxt_freshness_not_open_yet') }}&lt;/strong&gt;&lt;p&gt;{{ phrase('wrxt_freshness_voting_opens') }}: &lt;xf:date time="{$thread.getWrxtFreshnessEligibleDate()}" /&gt;&lt;/p&gt;&lt;/div&gt;
              &lt;/details&gt;
          &lt;/div&gt;
      &lt;/div&gt;
  &lt;/xf:if&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/xf:if&gt;
$0</replace>
  </modification>
</template_modifications>