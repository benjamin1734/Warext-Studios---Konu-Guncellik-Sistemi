<?xml version='1.0' encoding='UTF-8'?>
<template_modifications>
  <modification type="admin" template="forum_edit" modification_key="wrxt_thread_freshness_forum_edit" description="Forum bazlı konu güncellik ayarlarını ekler" execution_order="10" enabled="1" action="str_replace">
    <find>&lt;xf:option name="allow_posting"</find>
    <replace>&lt;xf:option name="wrxt_freshness_enabled" selected="$forum.wrxt_freshness_enabled"
    label="Konu güncellik doğrulamasını etkinleştir"
    hint="Bu forumdaki eski konularda topluluk güncellik doğrulaması açılır."&gt;
    &lt;div class="formRow-explain"&gt;Doğrulama panelinin görünmesi için geçmesi gereken gün sayısı&lt;/div&gt;
    &lt;xf:numberbox name="wrxt_freshness_days" value="{$forum.wrxt_freshness_days}" min="1" max="3650" step="1" /&gt;
    &lt;div class="formRow-explain"&gt;Yaş hesabı yöntemi&lt;/div&gt;
    &lt;xf:select name="wrxt_freshness_age_mode" value="{$forum.wrxt_freshness_age_mode}"&gt;
        &lt;xf:option value="meaningful"&gt;Anlamlı güncelleme (önerilen): konu sahibinin mesajları ve ilk mesaj düzenlemeleri&lt;/xf:option&gt;
        &lt;xf:option value="last_post"&gt;Her son mesaj konuyu yeniler&lt;/xf:option&gt;
    &lt;/xf:select&gt;
    &lt;div class="formRow-explain"&gt;İzin verilen sürümler, her satıra bir değer. Boş bırakılırsa serbest sürüm girişi kullanılır.&lt;/div&gt;
    &lt;xf:textarea name="wrxt_freshness_versions" value="{$forum.wrxt_freshness_versions}" autosize="true" maxlength="5000" /&gt;
&lt;/xf:option&gt;

$0</replace>
  </modification>
  <modification type="public" template="forum_view" modification_key="wrxt_thread_freshness_forum_filter" description="Forum konu listesine güncellik filtre menüsü ekler" execution_order="20" enabled="1" action="str_replace">
    <find>&lt;xf:ad position="forum_view_above_thread_list" arg-forum="{$forum}" /&gt;</find>
    <replace>&lt;xf:if is="$forum.wrxt_freshness_enabled"&gt;
    &lt;div class="block-outer"&gt;
        &lt;div class="block-outer-opposite"&gt;
            &lt;a class="button button--link menuTrigger" data-xf-click="menu" role="button" tabindex="0" aria-expanded="false" aria-haspopup="true"&gt;Güncellik filtresi&lt;/a&gt;
            &lt;div class="menu" data-menu="menu" aria-hidden="true"&gt;
                &lt;div class="menu-content"&gt;
                    &lt;a class="menu-linkRow" href="{{ link('forums', $forum, array_merge($filters, {'freshness_status': null})) }}"&gt;Tümü&lt;/a&gt;
                    &lt;a class="menu-linkRow" href="{{ link('forums', $forum, array_merge($filters, {'freshness_status': 'current'})) }}"&gt;Güncel&lt;/a&gt;
                    &lt;a class="menu-linkRow" href="{{ link('forums', $forum, array_merge($filters, {'freshness_status': 'likely_current'})) }}"&gt;Muhtemelen güncel&lt;/a&gt;
                    &lt;a class="menu-linkRow" href="{{ link('forums', $forum, array_merge($filters, {'freshness_status': 'mixed'})) }}"&gt;Kararsız&lt;/a&gt;
                    &lt;a class="menu-linkRow" href="{{ link('forums', $forum, array_merge($filters, {'freshness_status': 'questionable'})) }}"&gt;Güncelliği şüpheli&lt;/a&gt;
                    &lt;a class="menu-linkRow" href="{{ link('forums', $forum, array_merge($filters, {'freshness_status': 'not_working'})) }}"&gt;Artık çalışmıyor&lt;/a&gt;
                    &lt;a class="menu-linkRow" href="{{ link('forums', $forum, array_merge($filters, {'freshness_status': 'revalidating'})) }}"&gt;Yeniden doğrulanıyor&lt;/a&gt;
                    &lt;a class="menu-linkRow" href="{{ link('forums', $forum, array_merge($filters, {'freshness_status': 'unverified'})) }}"&gt;Doğrulanmamış&lt;/a&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/xf:if&gt;
$0</replace>
  </modification>
  <modification type="public" template="thread_view" modification_key="wrxt_thread_freshness_moderator" description="Konu güncellik moderatör doğrulama panelini ekler" execution_order="20" enabled="1" action="preg_replace">
    <find>#&lt;xf:ad position="thread_view_below_messages" arg-thread="\{\$thread\}" /&gt;#</find>
    <replace>&lt;xf:if is="$thread.canWrxtFreshnessModerate()"&gt;
	&lt;xf:set var="$wrxtModState" value="{$thread.getWrxtFreshnessState()}" /&gt;
	&lt;div class="block" id="wrxt-thread-freshness-moderator"&gt;
		&lt;div class="block-container"&gt;
			&lt;h3 class="block-header"&gt;Moderatör doğrulaması&lt;/h3&gt;
			&lt;div class="block-body"&gt;
				&lt;div class="block-row"&gt;
					&lt;xf:form action="{{ link('threads/freshness-moderate', $thread) }}" ajax="true"&gt;
						&lt;xf:selectrow name="moderator_status" label="Doğrulama durumu" value="{{ $wrxtModState ? $wrxtModState.moderator_status : '' }}"&gt;
							&lt;xf:option value=""&gt;Topluluk sonucunu kullan&lt;/xf:option&gt;
							&lt;xf:option value="current"&gt;Moderatör doğruladı: güncel&lt;/xf:option&gt;
							&lt;xf:option value="review"&gt;Moderatör: kontrol gerekli&lt;/xf:option&gt;
							&lt;xf:option value="not_working"&gt;Moderatör doğruladı: çalışmıyor&lt;/xf:option&gt;
						&lt;/xf:selectrow&gt;
						&lt;xf:submitrow submit="Kaydet" /&gt;
					&lt;/xf:form&gt;
				&lt;/div&gt;
			&lt;/div&gt;
		&lt;/div&gt;
	&lt;/div&gt;
&lt;/xf:if&gt;
$0</replace>
  </modification>
  <modification type="public" template="thread_view" modification_key="wrxt_thread_freshness_replacement" description="Eski konudan güncel çözüme yönlendirme panelini ekler" execution_order="30" enabled="1" action="preg_replace">
    <find>#&lt;xf:ad position="thread_view_below_messages" arg-thread="\{\$thread\}" /&gt;#</find>
    <replace>&lt;xf:set var="$wrxtReplacement" value="{$thread.getWrxtFreshnessReplacementThread()}" /&gt;
&lt;xf:set var="$wrxtSuggestions" value="{$thread.getWrxtFreshnessAlternativeSuggestions()}" /&gt;
&lt;xf:if is="$wrxtReplacement OR $thread.canWrxtFreshnessManageReplacement()"&gt;
    &lt;div class="block" id="wrxt-thread-freshness-replacement"&gt;
        &lt;div class="block-container"&gt;
            &lt;h3 class="block-header"&gt;Güncel çözüm&lt;/h3&gt;
            &lt;div class="block-body"&gt;
                &lt;xf:if is="$wrxtReplacement"&gt;
                    &lt;div class="block-row"&gt;Bu konu için daha güncel çözüm: &lt;a href="{{ link('threads', $wrxtReplacement) }}"&gt;&lt;strong&gt;{$wrxtReplacement.title}&lt;/strong&gt;&lt;/a&gt;&lt;/div&gt;
                &lt;/xf:if&gt;
                &lt;xf:if is="$wrxtSuggestions"&gt;
                    &lt;div class="block-row"&gt;
                        &lt;strong&gt;Topluluk tarafından önerilen alternatifler&lt;/strong&gt;
                        &lt;xf:foreach loop="$wrxtSuggestions" value="$wrxtSuggestion"&gt;
                            &lt;dl class="pairs pairs--justified"&gt;&lt;dt&gt;&lt;a href="{{ link('threads', $wrxtSuggestion.thread) }}"&gt;{$wrxtSuggestion.thread.title}&lt;/a&gt;&lt;/dt&gt;&lt;dd&gt;{$wrxtSuggestion.total|number} öneri&lt;/dd&gt;&lt;/dl&gt;
                        &lt;/xf:foreach&gt;
                    &lt;/div&gt;
                &lt;/xf:if&gt;
                &lt;xf:if is="$thread.canWrxtFreshnessManageReplacement()"&gt;
                    &lt;div class="block-row"&gt;
                        &lt;xf:form action="{{ link('threads/freshness-replacement', $thread) }}" ajax="true"&gt;
                            &lt;xf:numberboxrow name="replacement_thread_id" value="{{ $thread.getWrxtFreshnessState() ? $thread.getWrxtFreshnessState().replacement_thread_id : 0 }}" min="0" label="Güncel çözüm konu ID" explain="0 girerek yönlendirmeyi kaldırabilirsiniz. Yalnızca görüntülenebilir ve bu konudan daha yeni konular kabul edilir." /&gt;
                            &lt;xf:submitrow submit="Kaydet" /&gt;
                        &lt;/xf:form&gt;
                    &lt;/div&gt;
                &lt;/xf:if&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/xf:if&gt;
$0</replace>
  </modification>
  <modification type="public" template="thread_list_macros" modification_key="wrxt_thread_freshness_thread_list" description="Konu listesine güncellik durum rozetini ekler" execution_order="20" enabled="1" action="str_replace">
    <find>&lt;xf:if is="$thread.prefix_id"&gt;</find>
    <replace>&lt;xf:if is="$thread.hasWrxtFreshnessListData() AND $thread.isWrxtFreshnessEligible()"&gt;
    &lt;xf:set var="$wrxtListStatus" value="{$thread.getWrxtFreshnessDisplayStatus()}" /&gt;
    &lt;xf:if is="$wrxtListStatus == 'current'"&gt;
        &lt;span class="label label--green"&gt;Güncel&lt;/span&gt;
    &lt;xf:elseif is="$wrxtListStatus == 'likely_current'" /&gt;
        &lt;span class="label label--olive"&gt;Muhtemelen güncel&lt;/span&gt;
    &lt;xf:elseif is="$wrxtListStatus == 'mixed'" /&gt;
        &lt;span class="label label--yellow"&gt;Kararsız&lt;/span&gt;
    &lt;xf:elseif is="$wrxtListStatus == 'questionable'" /&gt;
        &lt;span class="label label--orange"&gt;Güncelliği şüpheli&lt;/span&gt;
    &lt;xf:elseif is="$wrxtListStatus == 'not_working'" /&gt;
        &lt;span class="label label--red"&gt;Artık çalışmıyor&lt;/span&gt;
    &lt;xf:elseif is="$wrxtListStatus == 'revalidating'" /&gt;
        &lt;span class="label label--blue"&gt;Yeniden doğrulanıyor&lt;/span&gt;
    &lt;xf:else /&gt;
        &lt;span class="label"&gt;Doğrulanmamış&lt;/span&gt;
    &lt;/xf:if&gt;
&lt;/xf:if&gt;
$0</replace>
  </modification>
  <modification type="public" template="thread_view" modification_key="wrxt_thread_freshness_thread_view" description="Konu güncellik doğrulama panelini konu görünümüne ekler" execution_order="10" enabled="1" action="preg_replace">
    <find>#&lt;xf:ad position="thread_view_below_messages" arg-thread="\{\$thread\}" /&gt;#</find>
    <replace>&lt;xf:if is="$thread.isWrxtFreshnessEnabled()"&gt;
    &lt;xf:if is="$thread.isWrxtFreshnessEligible()"&gt;
    &lt;xf:set var="$wrxtState" value="{$thread.getWrxtFreshnessState()}" /&gt;
    &lt;xf:set var="$wrxtStateCurrent" value="{$thread.isWrxtFreshnessStateCurrent()}" /&gt;
    &lt;xf:set var="$wrxtDisplayStatus" value="{$thread.getWrxtFreshnessDisplayStatus()}" /&gt;
    &lt;xf:set var="$wrxtVisitorVote" value="{$thread.getWrxtFreshnessVisitorVote()}" /&gt;
    &lt;xf:set var="$wrxtVoteEntity" value="{$thread.getWrxtFreshnessVisitorVoteEntity()}" /&gt;
    &lt;xf:set var="$wrxtVersions" value="{$thread.getWrxtFreshnessConfiguredVersions()}" /&gt;
    &lt;xf:set var="$wrxtVersionSummary" value="{$thread.getWrxtFreshnessVersionSummary()}" /&gt;
    &lt;xf:set var="$wrxtReasonSummary" value="{$thread.getWrxtFreshnessFailureReasonSummary()}" /&gt;
    &lt;div class="block" id="wrxt-thread-freshness"&gt;
        &lt;div class="block-container"&gt;
            &lt;h3 class="block-header"&gt;Bu çözüm hâlâ geçerli mi?&lt;/h3&gt;
            &lt;div class="block-body"&gt;
                &lt;div class="block-row"&gt;
                    &lt;div&gt;Bu konu belirlenen güncellik eşiğini geçti. Çözümü gerçekten denediyseniz sonucu bildirebilirsiniz.&lt;/div&gt;
                    &lt;xf:if is="$wrxtStateCurrent AND $wrxtState"&gt;
                        &lt;dl class="pairs pairs--justified"&gt;&lt;dt&gt;Çalıştı&lt;/dt&gt;&lt;dd&gt;{$wrxtState.positive_count}&lt;/dd&gt;&lt;/dl&gt;
                        &lt;dl class="pairs pairs--justified"&gt;&lt;dt&gt;Çalışmadı&lt;/dt&gt;&lt;dd&gt;{$wrxtState.negative_count}&lt;/dd&gt;&lt;/dl&gt;
                        &lt;dl class="pairs pairs--justified"&gt;&lt;dt&gt;Toplam oy&lt;/dt&gt;&lt;dd&gt;{$wrxtState.vote_count}&lt;/dd&gt;&lt;/dl&gt;
                        &lt;dl class="pairs pairs--justified"&gt;
                            &lt;dt&gt;Güncellik durumu&lt;/dt&gt;
                            &lt;dd&gt;
                                &lt;xf:if is="$wrxtDisplayStatus == 'current'"&gt;&lt;span class="label label--green"&gt;Güncel&lt;/span&gt;
                                &lt;xf:elseif is="$wrxtDisplayStatus == 'likely_current'" /&gt;&lt;span class="label label--olive"&gt;Muhtemelen güncel&lt;/span&gt;
                                &lt;xf:elseif is="$wrxtDisplayStatus == 'mixed'" /&gt;&lt;span class="label label--yellow"&gt;Kararsız&lt;/span&gt;
                                &lt;xf:elseif is="$wrxtDisplayStatus == 'questionable'" /&gt;&lt;span class="label label--orange"&gt;Güncelliği şüpheli&lt;/span&gt;
                                &lt;xf:elseif is="$wrxtDisplayStatus == 'not_working'" /&gt;&lt;span class="label label--red"&gt;Artık çalışmıyor&lt;/span&gt;
                                &lt;xf:elseif is="$wrxtDisplayStatus == 'revalidating'" /&gt;&lt;span class="label label--blue"&gt;Yeniden doğrulanıyor&lt;/span&gt;
                                &lt;xf:else /&gt;&lt;span class="label"&gt;Doğrulanmamış&lt;/span&gt;&lt;/xf:if&gt;
                            &lt;/dd&gt;
                        &lt;/dl&gt;
                        &lt;xf:if is="$wrxtState.last_verified_date"&gt;
                            &lt;dl class="pairs pairs--justified"&gt;&lt;dt&gt;Son topluluk doğrulaması&lt;/dt&gt;&lt;dd&gt;&lt;xf:date time="$wrxtState.last_verified_date" /&gt;&lt;/dd&gt;&lt;/dl&gt;
                        &lt;/xf:if&gt;
                        &lt;xf:if is="$wrxtState.moderator_status"&gt;
                            &lt;div class="formRow-explain"&gt;Gösterilen durum moderatör doğrulaması içeriyor.&lt;/div&gt;
                        &lt;/xf:if&gt;
                    &lt;xf:else /&gt;
                        &lt;div class="formRow-explain"&gt;Bu güncelleme döngüsü henüz doğrulanmadı.&lt;/div&gt;
                    &lt;/xf:if&gt;
                    &lt;xf:if is="$thread.hasWrxtFreshnessOwnerClaim()"&gt;
                        &lt;div class="blockMessage blockMessage--important"&gt;Konu sahibi bu çözümün hâlâ geçerli olduğunu bildirdi. Bu bildirim topluluk oylarının yerini almaz.&lt;/div&gt;
                    &lt;/xf:if&gt;
                &lt;/div&gt;
                &lt;xf:if is="$wrxtReasonSummary"&gt;
                    &lt;div class="block-row"&gt;
                        &lt;strong&gt;Çalışmama nedenleri&lt;/strong&gt;
                        &lt;xf:foreach loop="$wrxtReasonSummary" key="$wrxtReason" value="$wrxtReasonTotal"&gt;
                            &lt;dl class="pairs pairs--justified"&gt;
                                &lt;dt&gt;
                                    &lt;xf:if is="$wrxtReason == 'outdated_version'"&gt;Yeni sürümde çalışmıyor
                                    &lt;xf:elseif is="$wrxtReason == 'dead_links'" /&gt;Dosya veya bağlantılar çalışmıyor
                                    &lt;xf:elseif is="$wrxtReason == 'method_invalid'" /&gt;Yöntem artık geçerli değil
                                    &lt;xf:elseif is="$wrxtReason == 'incomplete'" /&gt;Çözüm eksik
                                    &lt;xf:elseif is="$wrxtReason == 'did_not_work'" /&gt;Sistemde çalışmadı
                                    &lt;xf:else /&gt;Diğer&lt;/xf:if&gt;
                                &lt;/dt&gt;
                                &lt;dd&gt;{$wrxtReasonTotal|number}&lt;/dd&gt;
                            &lt;/dl&gt;
                        &lt;/xf:foreach&gt;
                    &lt;/div&gt;
                &lt;/xf:if&gt;
                &lt;xf:if is="$wrxtVersionSummary"&gt;
                    &lt;div class="block-row"&gt;
                        &lt;strong&gt;Sürüm bazlı sonuçlar&lt;/strong&gt;
                        &lt;xf:foreach loop="$wrxtVersionSummary" value="$wrxtVersionRow"&gt;
                            &lt;dl class="pairs pairs--justified"&gt;
                                &lt;dt&gt;{$wrxtVersionRow.version}&lt;/dt&gt;
                                &lt;dd&gt;{$wrxtVersionRow.positive_count} çalıştı / {$wrxtVersionRow.negative_count} çalışmadı&lt;/dd&gt;
                            &lt;/dl&gt;
                        &lt;/xf:foreach&gt;
                    &lt;/div&gt;
                &lt;/xf:if&gt;
                &lt;xf:if is="$thread.canWrxtFreshnessOwnerClaim()"&gt;
                    &lt;div class="block-row"&gt;
                        &lt;xf:form action="{{ link('threads/freshness-owner-claim', $thread) }}" ajax="true"&gt;
                            &lt;xf:hiddenval name="claimed"&gt;{{ $thread.hasWrxtFreshnessOwnerClaim() ? 0 : 1 }}&lt;/xf:hiddenval&gt;
                            &lt;xf:button type="submit" class="button--primary"&gt;{{ $thread.hasWrxtFreshnessOwnerClaim() ? 'Doğrulamayı kaldır' : 'Konu sahibi: hâlâ geçerli' }}&lt;/xf:button&gt;
                        &lt;/xf:form&gt;
                    &lt;/div&gt;
                &lt;/xf:if&gt;
                &lt;xf:if is="$thread.canWrxtFreshnessVote()"&gt;
                    &lt;div class="block-row"&gt;
                        &lt;xf:form action="{{ link('threads/freshness-vote', $thread) }}" ajax="true"&gt;
                            &lt;xf:if is="$wrxtVersions"&gt;
                                &lt;xf:selectrow name="version" value="{{ $wrxtVoteEntity ? $wrxtVoteEntity.version : '' }}" label="Denediğiniz sürüm"&gt;
                                    &lt;xf:option value=""&gt;Sürüm seçin&lt;/xf:option&gt;
                                    &lt;xf:foreach loop="$wrxtVersions" value="$wrxtVersion"&gt;&lt;xf:option value="{$wrxtVersion}"&gt;{$wrxtVersion}&lt;/xf:option&gt;&lt;/xf:foreach&gt;
                                &lt;/xf:selectrow&gt;
                            &lt;xf:else /&gt;
                                &lt;xf:textboxrow name="version" value="{{ $wrxtVoteEntity ? $wrxtVoteEntity.version : '' }}" maxlength="100" label="Denediğiniz sürüm" /&gt;
                            &lt;/xf:if&gt;
                            &lt;xf:selectrow name="reason" value="{{ $wrxtVoteEntity ? $wrxtVoteEntity.reason : '' }}" label="Çalışmama nedeni"&gt;
                                &lt;xf:option value=""&gt;Seçmek istemiyorum&lt;/xf:option&gt;
                                &lt;xf:option value="outdated_version"&gt;Yeni sürümde çalışmıyor&lt;/xf:option&gt;
                                &lt;xf:option value="dead_links"&gt;Dosya veya bağlantılar çalışmıyor&lt;/xf:option&gt;
                                &lt;xf:option value="method_invalid"&gt;Yöntem artık geçerli değil&lt;/xf:option&gt;
                                &lt;xf:option value="incomplete"&gt;Çözüm eksik&lt;/xf:option&gt;
                                &lt;xf:option value="did_not_work"&gt;Benim sistemimde çalışmadı&lt;/xf:option&gt;
                                &lt;xf:option value="other"&gt;Diğer&lt;/xf:option&gt;
                            &lt;/xf:selectrow&gt;
                            &lt;xf:textboxrow name="message" value="{{ $wrxtVoteEntity ? $wrxtVoteEntity.message : '' }}" maxlength="500" label="Kısa açıklama" /&gt;
                            &lt;xf:numberboxrow name="alternative_thread_id" value="{{ $wrxtVoteEntity ? $wrxtVoteEntity.alternative_thread_id : 0 }}" min="0" label="Daha güncel konu ID (isteğe bağlı)" explain="Yalnızca çalışmadı oyunda kullanılır. 0 bırakırsanız öneri gönderilmez." /&gt;
                            &lt;div class="formSubmitRow"&gt;&lt;div class="formSubmitRow-main"&gt;&lt;div class="formSubmitRow-bar"&gt;&lt;/div&gt;&lt;div class="formSubmitRow-controls"&gt;
                                &lt;xf:button type="submit" name="vote" value="1" class="button--primary"&gt;Denedim, çalıştı&lt;/xf:button&gt;
                                &lt;xf:button type="submit" name="vote" value="-1"&gt;Denedim, çalışmadı&lt;/xf:button&gt;
                            &lt;/div&gt;&lt;/div&gt;&lt;/div&gt;
                            &lt;xf:if is="$wrxtVisitorVote == 1"&gt;&lt;div class="formRow-explain"&gt;Mevcut oyunuz: çalıştı&lt;/div&gt;
                            &lt;xf:elseif is="$wrxtVisitorVote == -1" /&gt;&lt;div class="formRow-explain"&gt;Mevcut oyunuz: çalışmadı&lt;/div&gt;&lt;/xf:if&gt;
                        &lt;/xf:form&gt;
                    &lt;/div&gt;
                &lt;xf:elseif is="$wrxtVisitorVote" /&gt;
                    &lt;div class="block-row formRow-explain"&gt;Bu doğrulama döngüsünde oyunuzu kullandınız ve oy değiştirme yetkiniz yok.&lt;/div&gt;
                &lt;xf:else /&gt;
                    &lt;div class="block-row formRow-explain"&gt;Bu konu için oy kullanma şartlarını karşılamıyorsunuz.&lt;/div&gt;
                &lt;/xf:if&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
    &lt;xf:else /&gt;
        &lt;div class="block" id="wrxt-thread-freshness"&gt;
            &lt;div class="block-container"&gt;
                &lt;h3 class="block-header"&gt;Konu güncellik doğrulaması&lt;/h3&gt;
                &lt;div class="block-body"&gt;
                    &lt;div class="block-row"&gt;
                        &lt;div&gt;Bu forumda güncellik sistemi aktif. Oy verme, konu belirlenen güncellik eşiğine ulaştığında açılır.&lt;/div&gt;
                        &lt;dl class="pairs pairs--justified"&gt;&lt;dt&gt;Gün eşiği&lt;/dt&gt;&lt;dd&gt;{$thread.Forum.wrxt_freshness_days} gün&lt;/dd&gt;&lt;/dl&gt;
                        &lt;dl class="pairs pairs--justified"&gt;&lt;dt&gt;Oy verme açılış tarihi&lt;/dt&gt;&lt;dd&gt;&lt;xf:date time="{$thread.getWrxtFreshnessEligibleDate()}" /&gt;&lt;/dd&gt;&lt;/dl&gt;
                        &lt;dl class="pairs pairs--justified"&gt;&lt;dt&gt;Kalan süre&lt;/dt&gt;&lt;dd&gt;{$thread.getWrxtFreshnessDaysUntilEligible()} gün&lt;/dd&gt;&lt;/dl&gt;
                    &lt;/div&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/xf:if&gt;
&lt;/xf:if&gt;
$0</replace>
  </modification>
</template_modifications>