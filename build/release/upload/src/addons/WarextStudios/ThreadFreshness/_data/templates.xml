<?xml version='1.0' encoding='utf-8'?>
<templates>
  <template type="admin" title="wrxt_thread_freshness_dashboard" version_id="1010070" version_string="1.0.0">&lt;xf:title&gt;Konu Güncellik Sistemi&lt;/xf:title&gt;

&lt;xf:pageaction&gt;
    &lt;xf:button href="{{ link('thread-freshness/forums') }}"&gt;Forum/Kategori Ayarları&lt;/xf:button&gt;
    &lt;xf:button href="{{ link('thread-freshness/settings') }}"&gt;Genel Ayarlar&lt;/xf:button&gt;
&lt;/xf:pageaction&gt;

&lt;div class="block"&gt;
    &lt;div class="block-container"&gt;
        &lt;h2 class="block-header"&gt;İçerik sağlığı özeti&lt;/h2&gt;
        &lt;div class="block-body"&gt;&lt;div class="block-row"&gt;
            &lt;dl class="pairs pairs--columns"&gt;&lt;dt&gt;Etkin forum konusu&lt;/dt&gt;&lt;dd&gt;{$stats.active_threads|number}&lt;/dd&gt;&lt;/dl&gt;
            &lt;dl class="pairs pairs--columns"&gt;&lt;dt&gt;Durum kaydı&lt;/dt&gt;&lt;dd&gt;{$stats.total|number}&lt;/dd&gt;&lt;/dl&gt;
            &lt;dl class="pairs pairs--columns"&gt;&lt;dt&gt;Toplam oy&lt;/dt&gt;&lt;dd&gt;{$stats.votes|number}&lt;/dd&gt;&lt;/dl&gt;
            &lt;dl class="pairs pairs--columns"&gt;&lt;dt&gt;Alternatif çözüm önerisi&lt;/dt&gt;&lt;dd&gt;{$stats.alternative_suggestions|number}&lt;/dd&gt;&lt;/dl&gt;
            &lt;dl class="pairs pairs--columns"&gt;&lt;dt&gt;Etkin forum&lt;/dt&gt;&lt;dd&gt;{$stats.enabled_forums|number}&lt;/dd&gt;&lt;/dl&gt;
            &lt;dl class="pairs pairs--columns"&gt;&lt;dt&gt;Güncel&lt;/dt&gt;&lt;dd&gt;{$stats.current|number}&lt;/dd&gt;&lt;/dl&gt;
            &lt;dl class="pairs pairs--columns"&gt;&lt;dt&gt;Muhtemelen güncel&lt;/dt&gt;&lt;dd&gt;{$stats.likely_current|number}&lt;/dd&gt;&lt;/dl&gt;
            &lt;dl class="pairs pairs--columns"&gt;&lt;dt&gt;Kararsız&lt;/dt&gt;&lt;dd&gt;{$stats.mixed|number}&lt;/dd&gt;&lt;/dl&gt;
            &lt;dl class="pairs pairs--columns"&gt;&lt;dt&gt;Güncelliği şüpheli&lt;/dt&gt;&lt;dd&gt;{$stats.questionable|number}&lt;/dd&gt;&lt;/dl&gt;
            &lt;dl class="pairs pairs--columns"&gt;&lt;dt&gt;Artık çalışmıyor&lt;/dt&gt;&lt;dd&gt;{$stats.not_working|number}&lt;/dd&gt;&lt;/dl&gt;
            &lt;dl class="pairs pairs--columns"&gt;&lt;dt&gt;Yeniden doğrulanıyor&lt;/dt&gt;&lt;dd&gt;{$stats.revalidating|number}&lt;/dd&gt;&lt;/dl&gt;
            &lt;dl class="pairs pairs--columns"&gt;&lt;dt&gt;Doğrulanmamış kayıt&lt;/dt&gt;&lt;dd&gt;{$stats.unverified|number}&lt;/dd&gt;&lt;/dl&gt;
        &lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;
&lt;/div&gt;

&lt;div class="block"&gt;
    &lt;div class="block-container"&gt;
        &lt;h2 class="block-header"&gt;Kontrol gerektiren konular&lt;/h2&gt;
        &lt;div class="block-body"&gt;
            &lt;xf:if is="$criticalThreads"&gt;
                &lt;xf:datalist data-xf-init="responsive-data-list"&gt;
                    &lt;xf:foreach loop="$criticalThreads" value="$row"&gt;
                        &lt;xf:datarow&gt;
                            &lt;xf:cell class="dataList-cell--main"&gt;
                                &lt;a href="{{ link('public:threads', $row.thread) }}" target="_blank"&gt;{$row.thread.title}&lt;/a&gt;
                                &lt;div class="dataList-subRow"&gt;Durum: {$row.effective_status} · Olumsuz: {$row.negative_count|number} · Toplam oy: {$row.vote_count|number}&lt;/div&gt;
                            &lt;/xf:cell&gt;
                        &lt;/xf:datarow&gt;
                    &lt;/xf:foreach&gt;
                &lt;/xf:datalist&gt;
            &lt;xf:else /&gt;&lt;div class="block-row"&gt;Kontrol gerektiren konu bulunmuyor.&lt;/div&gt;&lt;/xf:if&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/div&gt;

&lt;div class="block"&gt;
    &lt;div class="block-container"&gt;
        &lt;h2 class="block-header"&gt;Son olumsuz geri bildirimler&lt;/h2&gt;
        &lt;div class="block-body"&gt;
            &lt;xf:if is="$negativeFeedback"&gt;
                &lt;xf:datalist data-xf-init="responsive-data-list"&gt;
                    &lt;xf:foreach loop="$negativeFeedback" value="$vote"&gt;
                        &lt;xf:datarow&gt;
                            &lt;xf:cell class="dataList-cell--main"&gt;
                                &lt;xf:if is="$vote.Thread"&gt;&lt;a href="{{ link('public:threads', $vote.Thread) }}" target="_blank"&gt;{$vote.Thread.title}&lt;/a&gt;&lt;xf:else /&gt;Silinmiş konu #{$vote.thread_id}&lt;/xf:if&gt;
                                &lt;div class="dataList-subRow"&gt;
                                    &lt;xf:if is="$vote.User"&gt;{$vote.User.username} · &lt;/xf:if&gt;
                                    &lt;xf:date time="{{ $vote.updated_date ?: $vote.vote_date }}" /&gt;
                                    &lt;xf:if is="$vote.reason"&gt; · Neden: &lt;xf:if is="$vote.reason == 'outdated_version'"&gt;Yeni sürümde çalışmıyor&lt;xf:elseif is="$vote.reason == 'dead_links'" /&gt;Dosya/bağlantı çalışmıyor&lt;xf:elseif is="$vote.reason == 'method_invalid'" /&gt;Yöntem geçersiz&lt;xf:elseif is="$vote.reason == 'incomplete'" /&gt;Çözüm eksik&lt;xf:elseif is="$vote.reason == 'did_not_work'" /&gt;Sistemde çalışmadı&lt;xf:else /&gt;Diğer&lt;/xf:if&gt;&lt;/xf:if&gt;
                                    &lt;xf:if is="$vote.alternative_thread_id"&gt; · Alternatif konu: #{$vote.alternative_thread_id}&lt;/xf:if&gt;
                                    &lt;xf:if is="$vote.message"&gt;&lt;br /&gt;{$vote.message}&lt;/xf:if&gt;
                                &lt;/div&gt;
                            &lt;/xf:cell&gt;
                        &lt;/xf:datarow&gt;
                    &lt;/xf:foreach&gt;
                &lt;/xf:datalist&gt;
            &lt;xf:else /&gt;&lt;div class="block-row"&gt;Olumsuz geri bildirim bulunmuyor.&lt;/div&gt;&lt;/xf:if&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/div&gt;</template>
  <template type="public" title="alert_thread_wrxt_freshness_status" version_id="1010070" version_string="1.0.0">&lt;xf:set var="$wrxtTitle"&gt;&lt;a href="{{ link('threads', $content) }}" class="fauxBlockLink-blockLink"&gt;{$content.title}&lt;/a&gt;&lt;/xf:set&gt;
&lt;xf:if is="$alert.extra_data.status == 'questionable'"&gt;
	{{ phrase('wrxt_freshness_alert_questionable', {'title': $wrxtTitle}) }}
&lt;xf:elseif is="$alert.extra_data.status == 'not_working'" /&gt;
	{{ phrase('wrxt_freshness_alert_not_working', {'title': $wrxtTitle}) }}
&lt;xf:elseif is="$alert.extra_data.status == 'revalidating'" /&gt;
	{{ phrase('wrxt_freshness_alert_revalidating', {'title': $wrxtTitle}) }}
&lt;xf:else /&gt;
	{{ phrase('wrxt_freshness_alert_recovered', {'title': $wrxtTitle}) }}
&lt;/xf:if&gt;</template>
  <template type="public" title="push_thread_wrxt_freshness_status" version_id="1010070" version_string="1.0.0">&lt;xf:if is="$alert.extra_data.status == 'questionable'"&gt;
	{{ phrase('wrxt_freshness_alert_questionable', {'title': $content.title}) }}
&lt;xf:elseif is="$alert.extra_data.status == 'not_working'" /&gt;
	{{ phrase('wrxt_freshness_alert_not_working', {'title': $content.title}) }}
&lt;xf:elseif is="$alert.extra_data.status == 'revalidating'" /&gt;
	{{ phrase('wrxt_freshness_alert_revalidating', {'title': $content.title}) }}
&lt;xf:else /&gt;
	{{ phrase('wrxt_freshness_alert_recovered', {'title': $content.title}) }}
&lt;/xf:if&gt;
&lt;push:url&gt;{{ link('canonical:threads', $content) }}&lt;/push:url&gt;</template>
  <template type="public" title="wrxt_thread_freshness_search" version_id="1010070" version_string="1.0.0">&lt;xf:title&gt;Güncel Çözümler&lt;/xf:title&gt;

&lt;xf:form action="{{ link('guncel-cozumler') }}" method="get" class="block"&gt;
    &lt;div class="block-container"&gt;&lt;div class="block-body"&gt;
        &lt;xf:textboxrow name="q" value="{$query}" label="Anahtar kelime" placeholder="Konu başlığında ara" /&gt;
        &lt;xf:selectrow name="status" value="{$status}" label="Güncellik durumu"&gt;
            &lt;xf:option value="current"&gt;Güncel çözümler&lt;/xf:option&gt;
            &lt;xf:option value="likely_current"&gt;Muhtemelen güncel&lt;/xf:option&gt;
            &lt;xf:option value="mixed"&gt;Kararsız&lt;/xf:option&gt;
            &lt;xf:option value="questionable"&gt;Güncelliği şüpheli&lt;/xf:option&gt;
            &lt;xf:option value="not_working"&gt;Artık çalışmıyor&lt;/xf:option&gt;
            &lt;xf:option value="revalidating"&gt;Yeniden doğrulanıyor&lt;/xf:option&gt;
            &lt;xf:option value="unverified"&gt;Doğrulanmamış&lt;/xf:option&gt;
            &lt;xf:option value="all"&gt;Tüm durumlar&lt;/xf:option&gt;
        &lt;/xf:selectrow&gt;
        &lt;xf:submitrow submit="Ara" /&gt;
    &lt;/div&gt;&lt;/div&gt;
&lt;/xf:form&gt;

&lt;div class="block"&gt;
    &lt;div class="block-container"&gt;
        &lt;h2 class="block-header"&gt;Sonuçlar&lt;/h2&gt;
        &lt;div class="block-body"&gt;
            &lt;xf:if is="$results"&gt;
                &lt;xf:foreach loop="$results" value="$row"&gt;
                    &lt;div class="block-row"&gt;
                        &lt;a href="{{ link('threads', $row.thread) }}"&gt;&lt;strong&gt;{$row.thread.title}&lt;/strong&gt;&lt;/a&gt;
                        &lt;div class="contentRow-minor"&gt;
                            Durum:
                            &lt;xf:if is="$row.effective_status == 'current'"&gt;Güncel
                            &lt;xf:elseif is="$row.effective_status == 'likely_current'" /&gt;Muhtemelen güncel
                            &lt;xf:elseif is="$row.effective_status == 'mixed'" /&gt;Kararsız
                            &lt;xf:elseif is="$row.effective_status == 'questionable'" /&gt;Güncelliği şüpheli
                            &lt;xf:elseif is="$row.effective_status == 'not_working'" /&gt;Artık çalışmıyor
                            &lt;xf:elseif is="$row.effective_status == 'revalidating'" /&gt;Yeniden doğrulanıyor
                            &lt;xf:else /&gt;Doğrulanmamış&lt;/xf:if&gt;
                            · Çalıştı: {$row.positive_count|number} · Çalışmadı: {$row.negative_count|number} · Toplam oy: {$row.vote_count|number}
                            &lt;xf:if is="$row.last_verified_date"&gt; · Son doğrulama: &lt;xf:date time="$row.last_verified_date" /&gt;&lt;/xf:if&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;
                &lt;/xf:foreach&gt;
            &lt;xf:else /&gt;&lt;div class="block-row"&gt;Bu ölçütlere uygun konu bulunamadı.&lt;/div&gt;&lt;/xf:if&gt;
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/div&gt;</template>
  <template type="admin" title="wrxt_thread_freshness_option_rules" version_id="1010070" version_string="1.0.0">&lt;xf:numberboxrow name="{$inputName}[likely_min_votes]" value="{$option.option_value.likely_min_votes}" min="1" max="1000" label="Muhtemelen güncel: minimum oy" /&gt;
&lt;xf:numberboxrow name="{$inputName}[likely_min_percent]" value="{$option.option_value.likely_min_percent}" min="0" max="100" label="Muhtemelen güncel: minimum çalıştı yüzdesi" /&gt;
&lt;xf:numberboxrow name="{$inputName}[current_min_votes]" value="{$option.option_value.current_min_votes}" min="1" max="1000" label="Güncel: minimum oy" /&gt;
&lt;xf:numberboxrow name="{$inputName}[current_min_percent]" value="{$option.option_value.current_min_percent}" min="0" max="100" label="Güncel: minimum çalıştı yüzdesi" /&gt;
&lt;xf:numberboxrow name="{$inputName}[questionable_min_votes]" value="{$option.option_value.questionable_min_votes}" min="1" max="1000" label="Şüpheli: minimum oy" /&gt;
&lt;xf:numberboxrow name="{$inputName}[questionable_no_percent]" value="{$option.option_value.questionable_no_percent}" min="0" max="100" label="Şüpheli: minimum çalışmadı yüzdesi" /&gt;
&lt;xf:numberboxrow name="{$inputName}[not_working_min_votes]" value="{$option.option_value.not_working_min_votes}" min="1" max="1000" label="Artık çalışmıyor: minimum oy" /&gt;
&lt;xf:numberboxrow name="{$inputName}[not_working_no_percent]" value="{$option.option_value.not_working_no_percent}" min="0" max="100" label="Artık çalışmıyor: minimum çalışmadı yüzdesi" /&gt;
&lt;xf:numberboxrow name="{$inputName}[mixed_min_votes]" value="{$option.option_value.mixed_min_votes}" min="1" max="1000" label="Kararsız: minimum oy" /&gt;
&lt;xf:numberboxrow name="{$inputName}[mixed_low_percent]" value="{$option.option_value.mixed_low_percent}" min="0" max="100" label="Kararsız: alt çalıştı yüzdesi" /&gt;
&lt;xf:numberboxrow name="{$inputName}[mixed_high_percent]" value="{$option.option_value.mixed_high_percent}" min="0" max="100" label="Kararsız: üst çalıştı yüzdesi" /&gt;</template>
  <template type="admin" title="wrxt_thread_freshness_forums" version_id="1010072" version_string="1.0.0">&lt;xf:title&gt;Forum/Kategori Ayarları&lt;/xf:title&gt;

&lt;xf:form action="{{ link('thread-freshness/forums') }}" class="block"&gt;
    &lt;div class="block-container"&gt;
        &lt;h2 class="block-header"&gt;Güncellik sisteminin çalışacağı alanlar&lt;/h2&gt;
        &lt;div class="block-body"&gt;
            &lt;xf:numberboxrow name="days" value="{$days}" min="1" max="3650" step="1" label="Oy verme için gün eşiği" explain="Seçilen forumlara uygulanır. Test için 1 gün seçebilirsiniz." /&gt;
            &lt;xf:selectrow name="age_mode" value="{$ageMode}" label="Yaş hesabı"&gt;
                &lt;xf:option value="meaningful"&gt;Anlamlı güncelleme&lt;/xf:option&gt;
                &lt;xf:option value="last_post"&gt;Son mesaj&lt;/xf:option&gt;
            &lt;/xf:selectrow&gt;
            &lt;div class="block-row"&gt;Bir kategori seçildiğinde altındaki bütün forumlar etkinleştirilir. İsterseniz forumları tek tek de seçebilirsiniz.&lt;/div&gt;
            &lt;xf:foreach loop="$nodes" value="$node"&gt;
                &lt;xf:if is="$node.node_type_id == 'Category'"&gt;
                    &lt;div class="block-row"&gt;
                        &lt;xf:checkbox name="category_ids[]"&gt;
                            &lt;xf:option value="{$node.node_id}" selected="$node.category_selected"&gt;&lt;strong&gt;{$node.title}&lt;/strong&gt; ({$node.enabled_children|number}/{$node.forum_children|number} forum aktif)&lt;/xf:option&gt;
                        &lt;/xf:checkbox&gt;
                    &lt;/div&gt;
                &lt;xf:else /&gt;
                    &lt;div class="block-row"&gt;
                        &lt;xf:checkbox name="forum_ids[]"&gt;
                            &lt;xf:option value="{$node.node_id}" selected="$node.wrxt_freshness_enabled"&gt;{$node.title} · eşik: {$node.wrxt_freshness_days} gün&lt;/xf:option&gt;
                        &lt;/xf:checkbox&gt;
                    &lt;/div&gt;
                &lt;/xf:if&gt;
            &lt;/xf:foreach&gt;
            &lt;div class="block-row formRow-explain"&gt;Oy butonlarının görünmesi için kullanıcı grubunda Konu Güncellik Sistemi oy kullanma izni de açık olmalıdır.&lt;/div&gt;
        &lt;/div&gt;
        &lt;xf:submitrow submit="Kaydet" /&gt;
    &lt;/div&gt;
&lt;/xf:form&gt;</template>
</templates>